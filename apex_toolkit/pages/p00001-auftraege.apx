page 1 (
    name: Aufträge
    alias: AUFTRAEGE
    title: Aufträge
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }

    region auftraege (
        name: Aufträge
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id,
                       nr,
                       titel,
                       kunde,
                       ort,
                       case status
                           when 'OFFEN'     then 'Offen'
                           when 'IN_ARBEIT' then 'In Arbeit'
                           when 'ERLEDIGT'  then 'Erledigt'
                       end as status,
                       'Protokoll' as protokoll
                  from oe_auftrag
                 order by nr
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
            cssClasses: offline-prefetch
        }
        reportLayout {
            numberOfRows: 100
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: Keine Aufträge vorhanden.
        }

        column ID (
            type: hidden
            layout {
                sequence: 10
            }
        )
        column NR (
            type: link
            heading {
                heading: Nr.
            }
            layout {
                sequence: 20
            }
            link {
                target: {
                    page: 2
                    items: {
                        P2_ID: #ID#
                    }
                    clearCache: 2
                }
                linkText: #NR#
            }
        )
        column TITEL (
            type: plainText
            heading {
                heading: Titel
            }
            layout {
                sequence: 30
            }
        )
        column KUNDE (
            type: plainText
            heading {
                heading: Kunde
            }
            layout {
                sequence: 40
            }
        )
        column ORT (
            type: plainText
            heading {
                heading: Ort
            }
            layout {
                sequence: 50
            }
        )
        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 60
            }
        )
        column PROTOKOLL (
            type: link
            heading {
                heading: Protokoll
            }
            layout {
                sequence: 70
            }
            link {
                target: {
                    page: 3
                    items: {
                        P3_ID: #ID#
                    }
                    clearCache: 3
                }
                linkText: #PROTOKOLL#
            }
        )
    )

    // "Neuer Auftrag" als Link (nicht als Button): nur Links gehoeren zum Offline-Vorrat. Die Adresse samt
    // Pruefsumme berechnet apex_page.get_url; der Primaerschluessel bleibt leer (Pruefsumme auf Benutzerebene).
    // offline-drafts: hier erscheinen die offline angelegten, noch nicht uebertragenen Auftraege.
    region neu (
        name: Neuer Auftrag
        type: dynamicContent
        source {
            language: plsql
            plsqlFunctionBody:
                ```plsql
                return '<p style="margin: 0 0 8px"><a class="t-Button t-Button--hot" href="'
                    || apex_escape.html_attribute(apex_page.get_url(
                           p_page        => 2,
                           p_clear_cache => '2',
                           p_items       => 'P2_ID',
                           p_values      => null))
                    || '">Neuer Auftrag</a></p>';
                ```
        }
        layout {
            sequence: 5
            parentRegion: @auftraege
            slot: regionBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                offline-prefetch
                offline-drafts
            ]
        }
    )

)
