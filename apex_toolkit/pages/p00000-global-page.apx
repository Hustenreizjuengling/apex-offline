page 0 (
    name: Global Page
    appearance {
        templateOptions: #DEFAULT#
    }

    // Kennung fuer offline.js und offline-sw.js: nur angemeldete Seiten dieser App tragen sie
    // (nicht die Anmeldeseite, nicht die Fehlerseite von APEX). Daran erkennt die Offline-Schicht
    // eine echte, speicherbare Seite - ohne APEX-Markup zu lesen.
    region offline-kennung (
        name: Offline-Kennung
        type: staticContent
        source {
            htmlCode: <span id="offline-page" hidden></span>
        }
        layout {
            sequence: 1000
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    // Offline-Vorrat: dieselbe Liste wie das Navigationsmenue, unsichtbar. Ihre Links (APEX berechnet
    // Adressen und Pruefsummen) laedt offline.js im Hintergrund vor.
    region offline-vorrat (
        name: Offline-Vorrat
        type: list
        source {
            list: @navigation-menu
        }
        layout {
            sequence: 1010
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                offline-prefetch
                offline-hidden
            ]
        }
        componentAppearance {
            listTemplate: @/links-list
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    // Offline-Erfassung: auf Seiten mit offline-form uebernimmt offline.js das Speichern (Entwurf, dann
    // Absenden im unsichtbaren Rahmen durch dieselbe Seite). Abgebrochen wird mit der APEX-Aktion
    // Cancel Event - so beschreibt es die Dokumentation von apexbeforepagesubmit. this.data ist der Request.
    dynamicAction offline-erfassung (
        name: Offline-Erfassung
        execution {
            sequence: 10
        }
        when {
            event: apexbeforepagesubmit
        }
        clientSideCondition {
            type: jsExpression
            javaScriptExpression: !!window.offlineCapture && window.offlineCapture.takes(this.data)
        }

        action offline-erfassung-sichern (
            action: executeJsCode
            settings {
                jsCode: window.offlineCapture.save(this.data);
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action offline-erfassung-abbrechen (
            action: cancelEvent
            execution {
                sequence: 20
                fireOnInit: false
            }
        )
    )

)
